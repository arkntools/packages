{
  "compilerOptions": {
    "target": "esnext",
    "module": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "Node16",
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "declaration": true,
    "removeComments": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
