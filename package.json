{
  "name": "arkntools-packages-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "build:deps": "bun run --cwd packages/userscript-extension build && bun run --cwd packages/as-web-repo build",
    "postinstall": "bun run build:deps",
    "typecheck": "bun run --filter './packages/*' --if-present typecheck",
    "update-lock": "bun update --lockfile-only"
  }
}
